# Serve the Android app as an app download (Apache / LiteSpeed hosts; ignored elsewhere).
<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
</IfModule>
<FilesMatch "\.apk$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment; filename=BabyCare.apk"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</FilesMatch>
